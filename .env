# Calastone Pulse — Environment Variables
# =========================================
# These are documented here for reference.
# The actual runtime config is in config.js
# (which is loaded as a <script> by Market Research
# and Network Overview).
#
# Setup:
#   1. Copy config.example.js → config.js
#   2. Set ANTHROPIC_API_KEY in config.js
#   3. Keep the same values mirrored here for local docs
#
# DO NOT commit config.js to git.
# Rotate your API key at: https://console.anthropic.com

ANTHROPIC_API_KEY=PASTE-YOUR-KEY-HERE
CLAUDE_MODEL=claude-sonnet-4-6
