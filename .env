# Calastone Pulse — Environment Variables
# =========================================
# Runtime secrets live in gitignored .env.local and Vercel Project Settings.
#
# Required for Market Research (Claude):
#   ANTHROPIC_API_KEY=
#   CLAUDE_MODEL=claude-sonnet-4-6
#
# Required for Neon ontology (system of record):
#   DATABASE_URL=           # pooled — use for /api/* handlers
#   DATABASE_URL_UNPOOLED=  # direct — use for migrations
#
# Optional aliases (Vercel/Neon templates):
#   POSTGRES_URL=
#   POSTGRES_URL_NON_POOLING=
#
# Local static fallback for Claude (optional):
#   Copy config.example.js → config.js
#
# Setup:
#   1. Copy this file to .env.local and fill secrets
#   2. npm install
#   3. npm run db:setup
#   4. npm run dev
#
# DO NOT commit .env.local, config.js, or live credentials.

ANTHROPIC_API_KEY=PASTE-YOUR-KEY-HERE
CLAUDE_MODEL=claude-sonnet-4-6
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
