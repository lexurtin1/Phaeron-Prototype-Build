# Calastone Pulse — Environment Variables
# =========================================
# Runtime (preferred): set ANTHROPIC_API_KEY in Vercel Project Settings
# or in gitignored .env.local. The /api/claude serverless function
# reads it server-side so the key never ships to the browser.
#
# Local static fallback (optional):
#   1. Copy config.example.js → config.js
#   2. Paste the same key into config.js
#
# DO NOT commit config.js or .env.local.
# Rotate keys at: https://console.anthropic.com

ANTHROPIC_API_KEY=PASTE-YOUR-KEY-HERE
CLAUDE_MODEL=claude-sonnet-4-6
