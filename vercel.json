{
  "framework": null,
  "installCommand": "npm install && npm install --prefix pulse-ui",
  "buildCommand": "npm run build:ui",
  "outputDirectory": ".",
  "functions": {
    "api/claude.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/snapshot-intent.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/snapshot-qa.js": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/pulse/ui/index.html"
    },
    {
      "source": "/tools/agent-marketplace",
      "destination": "/pulse/ui/marketplace.html"
    },
    {
      "source": "/tools/agent-marketplace/",
      "destination": "/pulse/ui/marketplace.html"
    },
    {
      "source": "/tools/agent-marketplace/index.html",
      "destination": "/pulse/ui/marketplace.html"
    },
    {
      "source": "/((?!api/|config\\.js|Order).*)",
      "destination": "/pulse/$1"
    }
  ]
}
