{
  "name": "phaeron-pulse",
  "version": "1.0.0",
  "private": true,
  "description": "Phaeron Pulse — market research ontology on Neon",
  "scripts": {
    "dev": "node scripts/local-pulse-server.js",
    "dev:ui": "npm --prefix pulse-ui run dev",
    "build:ui": "npm --prefix pulse-ui run build",
    "build": "npm install --prefix pulse-ui && npm run build:ui",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed-atlas.js",
    "db:setup": "npm run migrate && npm run seed",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:smoke": "node tests/smoke-snapshot.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "ws": "^8.21.3"
  }
}
